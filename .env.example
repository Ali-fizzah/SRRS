# Copy to .env and adjust. docker-compose reads this file.
POSTGRES_USER=revrec
POSTGRES_PASSWORD=revrec
POSTGRES_DB=revrec
POSTGRES_PORT=5432

# Backend (pydantic-settings reads the REVREC_ prefix)
REVREC_DATABASE_URL=postgresql+psycopg://revrec:revrec@localhost:5432/revrec
# At least 32 characters; use a long random value outside development
REVREC_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0001
REVREC_UPLOAD_DIR=storage/uploads
# First admin user, created by `make seed` (only if this email does not exist yet)
REVREC_ADMIN_EMAIL=admin@revrec.local
REVREC_ADMIN_PASSWORD=ChangeMe-Admin1

# Frontend: where Next.js forwards /api/* (plan D11)
API_URL=http://localhost:8000
